# Copy to .env.local for local development (values from `npx supabase start`),
# and set the same names in Vercel for the hosted app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Must match app_settings.notify_secret in the database.
NOTIFY_SECRET=
# Optional: real emails through Resend. Without it, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=Connections <onboarding@resend.dev>
# Used in email links; defaults to the site's own address.
NEXT_PUBLIC_APP_URL=
# Where "Contact us" emails go.
NEXT_PUBLIC_SUPPORT_EMAIL=
